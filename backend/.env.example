# Raspberry Pi tip: keep ENABLE_FACE/ACTION/POSE/AUDIO=false until optional AI deps are installed.
ENABLE_DETECTOR=true
ENABLE_FACE=true
ENABLE_ACTION=true
ENABLE_POSE=true
ENABLE_AUDIO=true
MODEL_PATH=path/to/yolov8n.pt
MODEL_TYPE=yolov8
AUTO_MODEL_CANDIDATES=yolo11n.pt,yolov8n.pt
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
IMAGE_CAPTURE_INTERVAL=30
UPLOAD_COOLDOWN_SECONDS=10
USE_GPU=false
CAMERA_INDEX=0
CAMERA_BACKEND=
CAMERA_OPEN_TIMEOUT_S=5.0
CAMERA_REQUIRED=false
STREAM_FPS=10
CAPTURE_DIR=captures
FACE_DB_PATH=faces.db
FACE_MODEL_NAME=buffalo_lp
FACE_MATCH_THRESHOLD=0.45
FACE_RECOGNITION_INTERVAL=10
FACE_UNKNOWN_THRESHOLD=0.5
HF_TOKEN=your-hf-token
HF_EMOTION_URL=https://router.huggingface.co/hf-inference/models/dima806/facial_emotions_image_detection
ACTION_INTERVAL=10
ACTION_WINDOW_S=2.0
ACTION_FRAMES=16
ACTION_CONF_THRESHOLD=0.95
ACTION_MODEL_PATH=path/to/yolo26n-pose.pt
ACTION_MODEL_URL=https://github.com/ultralytics/assets/releases/download/v8.4.0/yolo26n-pose.pt
HF_AUDIO_URL=https://api-inference.huggingface.co/models/MIT/ast-finetuned-audioset-10-10-0.4593
AUDIO_INTERVAL=5
AUDIO_WINDOW_S=2.0
AUDIO_SAMPLE_RATE=16000
AUDIO_THRESHOLD=0.35
AUDIO_LABELS=scream,shout,yell,screaming
AUDIO_DEVICE=
AUDIO_LOCAL_MODEL=
EMOTION_CONF_THRESHOLD=0.4
SECURITY_UNKNOWN_SECONDS=5
MOTION_PIXEL_THRESHOLD=25
MOTION_MIN_PIXELS=5000
FACE_AFTER_MOTION_SECONDS=10.0
POST_FACE_WINDOW_S=8.0
POSE_MODEL_PATH=path/to/yolo26n-pose.pt
POSE_MODEL_URL=https://github.com/ultralytics/assets/releases/download/v8.4.0/yolo26n-pose.pt
POSE_INTERVAL=10
POSE_CONF_THRESHOLD=0.25
