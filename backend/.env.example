# Raspberry Pi tip: set ENABLE_AUDIO=false if no microphone is attached.
ENABLE_DETECTOR=true
ENABLE_FACE=true
ENABLE_ACTION=true
ENABLE_POSE=true
ENABLE_AUDIO=false
MODEL_PATH=yolo11n-pose.pt
MODEL_TYPE=yolo_pose
AUTO_MODEL_CANDIDATES=yolo11n-pose.pt,yolov8n-pose.pt
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
IMAGE_CAPTURE_INTERVAL=30
UPLOAD_COOLDOWN_SECONDS=10
USE_GPU=false
CAMERA_INDEX=0
CAMERA_BACKEND=
CAMERA_OPEN_TIMEOUT_S=5.0
CAMERA_REQUIRED=false
STREAM_FPS=10
RECORD_FPS=25
RECORDINGS_DIR=recordings
# Unauthenticated /demo/register page for bootstrapping the first face.
# Keep false on any public/deployed device (e.g. the Pi behind the tunnel).
# Set true only on a trusted/local machine.
ENABLE_DEMO_REGISTER=false
CAPTURE_DIR=captures
FACE_DB_PATH=faces.db
FACE_MODEL_NAME=buffalo_s
FACE_MATCH_THRESHOLD=0.45
FACE_RECOGNITION_INTERVAL=10
FACE_UNKNOWN_THRESHOLD=0.5
HF_TOKEN=your-hf-token
ACTION_INTERVAL=10
ACTION_CONF_THRESHOLD=0.5
HF_AUDIO_URL=https://api-inference.huggingface.co/models/MIT/ast-finetuned-audioset-10-10-0.4593
AUDIO_INTERVAL=5
AUDIO_WINDOW_S=2.0
AUDIO_SAMPLE_RATE=16000
AUDIO_THRESHOLD=0.35
AUDIO_LABELS=scream,shout,yell,screaming
AUDIO_DEVICE=
AUDIO_LOCAL_MODEL=
SECURITY_UNKNOWN_SECONDS=5
MOTION_PIXEL_THRESHOLD=25
MOTION_MIN_PIXELS=5000
FACE_AFTER_MOTION_SECONDS=10.0
POST_FACE_WINDOW_S=8.0
POSE_MODEL_PATH=
POSE_INTERVAL=10
POSE_CONF_THRESHOLD=0.25
